From 50b1e4540f56970cff66f42a2c0d7d27cd60540a Mon Sep 17 00:00:00 2001
From: Jean-Michel Hautbois <jeanmichel.hautbois@yoseli.org>
Date: Tue, 10 Feb 2026 15:04:31 +0100
Subject: [PATCH] gdbserver: Add m68k target description support

The m68k architecture support in gdbserver was incomplete - it declared
tdesc_m68k and init_registers_m68k() but never defined them, causing
an assertion failure at runtime:

  tdesc_get_features_xml: Assertion `tdesc->xmltarget != NULL ||
  (!tdesc->features.empty () && tdesc->arch != NULL)' failed.

Add linux-m68k-tdesc.cc which creates the m68k target description
programmatically using the org.gnu.gdb.coldfire.core and
org.gnu.gdb.coldfire.fp features.

Signed-off-by: Jean-Michel Hautbois <jeanmichel.hautbois@yoseli.org>
---
 gdbserver/Makefile.in         |   1 +
 gdbserver/configure.srv       |  14 +----
 gdbserver/linux-m68k-tdesc.cc | 100 ++++++++++++++++++++++++++++++++++
 3 files changed, 103 insertions(+), 12 deletions(-)
 create mode 100644 gdbserver/linux-m68k-tdesc.cc

diff --git a/gdbserver/Makefile.in b/gdbserver/Makefile.in
index 6148ccf..8a86642 100644
--- a/gdbserver/Makefile.in
+++ b/gdbserver/Makefile.in
@@ -198,6 +198,7 @@ SFILES = \
 	$(srcdir)/linux-loongarch-low.cc \
 	$(srcdir)/linux-low.cc \
 	$(srcdir)/linux-m68k-low.cc \
+	$(srcdir)/linux-m68k-tdesc.cc \
 	$(srcdir)/linux-mips-low.cc \
 	$(srcdir)/linux-nios2-low.cc \
 	$(srcdir)/linux-or1k-low.cc \
diff --git a/gdbserver/configure.srv b/gdbserver/configure.srv
index 9e861a7..849dbaa 100644
--- a/gdbserver/configure.srv
+++ b/gdbserver/configure.srv
@@ -139,22 +139,12 @@ case "${gdbserver_host}" in
 			srv_linux_usrregs=yes
 			srv_linux_thread_db=yes
 			;;
-  m68*-*-linux*)	if test "$gdb_cv_m68k_is_coldfire" = yes; then
-                          srv_regobj=reg-cf.o
-                        else
-                          srv_regobj=reg-m68k.o
-                        fi
-			srv_tgtobj="$srv_linux_obj linux-m68k-low.o"
+  m68*-*-linux*)	srv_tgtobj="$srv_linux_obj linux-m68k-low.o linux-m68k-tdesc.o"
 			srv_linux_usrregs=yes
 			srv_linux_regsets=yes
 			srv_linux_thread_db=yes
 			;;
-  m68*-*-uclinux*)	if test "$gdb_cv_m68k_is_coldfire" = yes; then
-                          srv_regobj=reg-cf.o
-                        else
-                          srv_regobj=reg-m68k.o
-                        fi
-			srv_tgtobj="$srv_linux_obj linux-m68k-low.o"
+  m68*-*-uclinux*)	srv_tgtobj="$srv_linux_obj linux-m68k-low.o linux-m68k-tdesc.o"
 			srv_linux_usrregs=yes
 			srv_linux_regsets=yes
 			srv_linux_thread_db=yes
diff --git a/gdbserver/linux-m68k-tdesc.cc b/gdbserver/linux-m68k-tdesc.cc
new file mode 100644
index 0000000..ce2ca6a
--- /dev/null
+++ b/gdbserver/linux-m68k-tdesc.cc
@@ -0,0 +1,100 @@
