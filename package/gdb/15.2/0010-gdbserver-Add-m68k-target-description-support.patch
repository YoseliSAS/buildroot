+/* M68K target description for gdbserver.  */
+
+#include "server.h"
+#include "tdesc.h"
+#include "gdbsupport/tdesc.h"
+
+/* The M68K target description.  */
+const struct target_desc *tdesc_m68k;
+
+/* Declared in linux-m68k-low.cc.  */
+void init_registers_m68k (void);
+
+/* Create the M68K target description.  */
+static struct target_desc *
+m68k_create_target_description (void)
+{
+  target_desc_up tdesc = allocate_target_description ();
+  long regnum = 0;
+
+  set_tdesc_architecture (tdesc.get (), "m68k");
+
+  /* Create the "org.gnu.gdb.coldfire.core" feature.  */
+  struct tdesc_feature *feature
+    = tdesc_create_feature (tdesc.get (), "org.gnu.gdb.coldfire.core");
+
+  /* Data registers d0-d7.  */
+  tdesc_create_reg (feature, "d0", regnum++, 1, NULL, 32, "int");
+  tdesc_create_reg (feature, "d1", regnum++, 1, NULL, 32, "int");
+  tdesc_create_reg (feature, "d2", regnum++, 1, NULL, 32, "int");
+  tdesc_create_reg (feature, "d3", regnum++, 1, NULL, 32, "int");
+  tdesc_create_reg (feature, "d4", regnum++, 1, NULL, 32, "int");
+  tdesc_create_reg (feature, "d5", regnum++, 1, NULL, 32, "int");
+  tdesc_create_reg (feature, "d6", regnum++, 1, NULL, 32, "int");
+  tdesc_create_reg (feature, "d7", regnum++, 1, NULL, 32, "int");
+
+  /* Address registers a0-a5.  */
+  tdesc_create_reg (feature, "a0", regnum++, 1, NULL, 32, "data_ptr");
+  tdesc_create_reg (feature, "a1", regnum++, 1, NULL, 32, "data_ptr");
+  tdesc_create_reg (feature, "a2", regnum++, 1, NULL, 32, "data_ptr");
+  tdesc_create_reg (feature, "a3", regnum++, 1, NULL, 32, "data_ptr");
+  tdesc_create_reg (feature, "a4", regnum++, 1, NULL, 32, "data_ptr");
+  tdesc_create_reg (feature, "a5", regnum++, 1, NULL, 32, "data_ptr");
+
+  /* Frame pointer (a6) and stack pointer (a7).  */
+  tdesc_create_reg (feature, "fp", regnum++, 1, NULL, 32, "data_ptr");
+  tdesc_create_reg (feature, "sp", regnum++, 1, NULL, 32, "data_ptr");
+
+  /* Status register and program counter.  */
+  tdesc_create_reg (feature, "ps", regnum++, 1, NULL, 32, "int");
+  tdesc_create_reg (feature, "pc", regnum++, 1, NULL, 32, "code_ptr");
+
+  /* Create the "org.gnu.gdb.coldfire.fp" feature for FP registers.  */
+  feature = tdesc_create_feature (tdesc.get (), "org.gnu.gdb.coldfire.fp");
+
+  /* FP registers fp0-fp7 (96-bit extended precision).  */
+  tdesc_create_reg (feature, "fp0", regnum++, 1, NULL, 96, "i387_ext");
+  tdesc_create_reg (feature, "fp1", regnum++, 1, NULL, 96, "i387_ext");
+  tdesc_create_reg (feature, "fp2", regnum++, 1, NULL, 96, "i387_ext");
+  tdesc_create_reg (feature, "fp3", regnum++, 1, NULL, 96, "i387_ext");
+  tdesc_create_reg (feature, "fp4", regnum++, 1, NULL, 96, "i387_ext");
+  tdesc_create_reg (feature, "fp5", regnum++, 1, NULL, 96, "i387_ext");
+  tdesc_create_reg (feature, "fp6", regnum++, 1, NULL, 96, "i387_ext");
+  tdesc_create_reg (feature, "fp7", regnum++, 1, NULL, 96, "i387_ext");
+
+  /* FP control registers.  */
+  tdesc_create_reg (feature, "fpcontrol", regnum++, 1, NULL, 32, "int");
+  tdesc_create_reg (feature, "fpstatus", regnum++, 1, NULL, 32, "int");
+  tdesc_create_reg (feature, "fpiaddr", regnum++, 1, NULL, 32, "code_ptr");
+
+  return tdesc.release ();
+}
+
+/* Initialize the M68K target description.  Called from initialize_low_arch.  */
+void
+init_registers_m68k (void)
+{
+  struct target_desc *tdesc = m68k_create_target_description ();
+
+  static const char *expedite_regs[] = { "sp", "fp", "pc", 0 };
+  init_target_desc (tdesc, expedite_regs);
+
+  tdesc_m68k = tdesc;
+}
