+   version 2.1 of the License, or (at your option) any later version.
+
+   The GNU C Library is distributed in the hope that it will be useful,
+   but WITHOUT ANY WARRANTY; without even the implied warranty of
+   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+   Lesser General Public License for more details.
+
+   You should have received a copy of the GNU Lesser General Public
+   License along with the GNU C Library; if not, see
+   <http://www.gnu.org/licenses/>.  */
+
+#ifndef _BITS_ATOMIC_H
+#define _BITS_ATOMIC_H 1
+
+#include <stdint.h>
+
+typedef int8_t atomic8_t;
+typedef uint8_t uatomic8_t;
+typedef int_fast8_t atomic_fast8_t;
+typedef uint_fast8_t uatomic_fast8_t;
+
+typedef int32_t atomic32_t;
+typedef uint32_t uatomic32_t;
+typedef int_fast32_t atomic_fast32_t;
+typedef uint_fast32_t uatomic_fast32_t;
+
+typedef intptr_t atomicptr_t;
+typedef uintptr_t uatomicptr_t;
+typedef intmax_t atomic_max_t;
+typedef uintmax_t uatomic_max_t;
+
+/* m68k Coldfire single core: a compiler barrier is sufficient.  */
+#define atomic_full_barrier() \
+	do { __asm__ __volatile__ ("" ::: "memory"); } while (0)
+
+/* Use the kernel sys_atomic_cmpxchg_32 syscall (NR 335) for the
+   primitive compare-and-exchange. The kernel runs the compare-and-swap
+   under mmap_read_lock on a non-preempt UP kernel, which makes it atomic
+   with respect to other userspace threads of the same process.
+
+   m68k syscall calling convention: arg1..arg5 in d1..d5, arg6 in a0.
+   sys_atomic_cmpxchg_32 takes: (newval, oldval, d3, d4, d5, mem) so:
+     d1 = newval, d2 = oldval, a0 = mem
+   d3, d4, d5 are unused placeholders that allow the kernel signature to
+   put mem in a0 (the 6th argument register). They are left uninitialized
+   on purpose.
+
+   The syscall returns the value that was at *mem before the operation.  */
+static __inline__ int
+__m68k_atomic_cmpxchg_32(int *mem, int oldval, int newval)
+{
+	register int _result  __asm__ ("d0") = 335; /* __NR_atomic_cmpxchg_32 */
+	register int _newval  __asm__ ("d1") = newval;
+	register int _oldval  __asm__ ("d2") = oldval;
+	register int *_memreg __asm__ ("a0") = mem;
+
+	__asm__ __volatile__ ("trap #0"
+		: "+d" (_result)
+		: "d" (_newval), "d" (_oldval), "a" (_memreg)
+		: "memory");
+
+	return _result;
+}
+
+#define __arch_compare_and_exchange_val_32_acq(mem, newval, oldval)		\
+	((__typeof(*(mem))) __m68k_atomic_cmpxchg_32((int *)(mem),		\
+						     (int)(oldval),		\
+						     (int)(newval)))
+
+/* The generic include/atomic.h __atomic_val_bysize macro references the
+   8, 16 and 64 bit variants in unreachable branches selected by sizeof,
+   so they must exist as identifiers even though they are never called
+   for our 32-bit-only target. Provide undefined link errors so any
+   accidental real use fails to link instead of compiling silently to
+   non-atomic code.  */
+extern void __m68k_link_error_no_8bit_atomic(void);
+extern void __m68k_link_error_no_16bit_atomic(void);
+extern void __m68k_link_error_no_64bit_atomic(void);
+
+#define __arch_compare_and_exchange_val_8_acq(mem, newval, oldval)		\
+	(__m68k_link_error_no_8bit_atomic(), (oldval))
+
+#define __arch_compare_and_exchange_val_16_acq(mem, newval, oldval)		\
+	(__m68k_link_error_no_16bit_atomic(), (oldval))
+
+#define __arch_compare_and_exchange_val_64_acq(mem, newval, oldval)		\
+	(__m68k_link_error_no_64bit_atomic(), (oldval))
+
+#endif /* bits/atomic.h */
-- 
