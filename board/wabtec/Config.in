choice
	prompt "Wabtec target board"
	default BR2_BOARD_DLC_NEXT
	help
	  Select the target Wabtec board variant. Each board selects a set
	  of BR2_SYSTEM_* flags that the post-build and image generation
	  scripts consume to gate platform-specific behavior (HW RNG
	  presence, swap requirement, persistent random-seed, ...).

config BR2_BOARD_DLC_NEXT
	bool "DLC-Next (MCF54418, imx-rngc)"
	select BR2_SYSTEM_HAS_HW_RNG
	help
	  DLC-Next door control unit, MCF54418 ColdFire SoC with the
	  imx-rngc hardware RNG block (RNGB IP), 256 MB RAM. The HW RNG
	  is auto-drained by the kernel hwrng kthread, so no userspace
	  random-seed persistence is required.

config BR2_BOARD_DLC2NG
	bool "DLC2NG (MCF54415, no HW RNG)"
	select BR2_SYSTEM_NEEDS_SWAP
	select BR2_SYSTEM_NEEDS_RANDOM_SEED_PERSIST
	help
	  Legacy DLC2NG door control unit, MCF54415 ColdFire SoC without
	  hardware RNG, 128 MB RAM. Requires a swap region for software
	  package decompression and a persistent random-seed (via busybox
	  seedrng) to bootstrap the kernel CRNG quickly across reboots.

endchoice

config BR2_SYSTEM_HAS_HW_RNG
	bool

config BR2_SYSTEM_NEEDS_SWAP
	bool

config BR2_SYSTEM_NEEDS_RANDOM_SEED_PERSIST
	bool
