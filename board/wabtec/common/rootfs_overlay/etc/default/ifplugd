# Configuration for ifplugd daemon
# This file is sourced by /etc/init.d/S41ifplugd

# List of interfaces to monitor (space-separated)
# Leave empty to use DEFAULT_IFACE only
INTERFACES="eth0 eth1"

# Default interface for the main S41ifplugd script (when no INTERFACES list)
# Set to empty to disable
DEFAULT_IFACE=""

# Arguments passed to ifplugd
# -M: Don't automatically bring up interface (let the action script handle it)
# -I: Don't exit on nonzero return from script
# -f: Don't daemonize (start-stop-daemon handles backgrounding)
# -t: Poll time in seconds
# -u: Delay before running script after link up
# -d: Delay before running script after link down
IFPLUGD_ARGS="-M -I -t 3 -u 2 -d 10"
