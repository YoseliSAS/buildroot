#!/bin/sh
#
# Start/stop nginx
#

NGINX=/usr/sbin/nginx
PIDFILE=/var/run/nginx.pid

case "$1" in
  start)
	echo "Starting nginx..."
	mkdir -p /var/log/nginx /var/cache/nginx

	# Enable core dumps for debugging ColdFire memory issues
	ulimit -c unlimited
	echo "/tmp/core.%e.%p" > /proc/sys/kernel/core_pattern

	# Delay to allow system initialization (ColdFire memory issue workaround)
	sleep 10

	# Let nginx daemonize itself
	"$NGINX"
	;;
  stop)
	echo "Stopping nginx..."
	start-stop-daemon -K -x "$NGINX" -p "$PIDFILE" -o
	;;
  reload|force-reload)
	echo "Reloading nginx configuration..."
	"$NGINX" -s reload
	;;
  restart)
	"$0" stop
	sleep 1 # Prevent race condition: ensure nginx stops before start.
	"$0" start
	;;
  *)
	echo "Usage: $0 {start|stop|restart|reload|force-reload}"
	exit 1
esac
