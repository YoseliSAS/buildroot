#! /bin/bash
#
# mountvolatile	This script remounts (in bind mode) some folders like /etc
#               to make them writable but non-persistent.
#
# Boot optimization: Mount /etc first, run ldconfig, then mount others.
# This way all subsequent mount commands benefit from ld.so.cache.
#

# shellcheck disable=SC2034  # Required by Buildroot SysV template; one-shot script
DAEMON="mountvolatile"

# Timestamp using shell built-in read (no fork)
ts() { read -r uptime _ < /proc/uptime; echo "[$uptime] $*"; }

# Load mount table once, check with shell pattern matching (no fork)
MOUNTS=$(cat /proc/mounts)
is_mountpoint() {
	case "$MOUNTS" in
		*" $1 "*) return 0 ;;
		*) return 1 ;;
	esac
}

# /etc is mounted first (for ldconfig), then others in parallel
ETC_ENTRY="/etc(nosuid,nodev)"
OTHER_FOLDERS="/var(nosuid,nodev):/home(nosuid,nodev):/run(nosuid,nodev)"
VOLATILE="/volatile"
# Use shell parameter expansion instead of forking basename
SCRIPTNAME="${0##*/}"

[ -d "$VOLATILE" ] || exit 0

# Helper: mount a single overlay
mount_overlay() {
	local entry="$1"
	local folder="${entry%%(*}"
	local options="${entry#*(}" options="${options%)}"
	local bfolder="${folder##*/}"
	local upperdir="$VOLATILE/${bfolder}_upper"
	local workdir="$VOLATILE/${bfolder}_work"

	mkdir -p "$upperdir" "$workdir"
	chown --reference="$folder" "$upperdir"
	chmod --reference="$folder" "$upperdir"

	local mount_opts="lowerdir=$folder,upperdir=$upperdir,workdir=$workdir"
	[[ -n "$options" && "$options" != "$folder" ]] && mount_opts="$mount_opts,$options"

	mount -t overlay overlay -o "$mount_opts" "$folder"
}

case "$1" in
	start|"")
		ts "$SCRIPTNAME: start"

		# Step 1: Mount /etc first (synchronously) so ldconfig can use it
		if ! is_mountpoint "/etc"; then
			ts "$SCRIPTNAME: mount /etc"
			mount_overlay "$ETC_ENTRY"
		fi

		# Step 2: ld.so.cache is pre-generated at build time by
		# post-build.sh and embedded in the rootfs. The overlayfs on
		# /etc exposes it from the lowerdir. No runtime generation needed.
		if [ -f /etc/ld.so.cache ]; then
			ts "$SCRIPTNAME: ld.so.cache (pre-built)"
		elif [ -x /sbin/ldconfig ]; then
			ts "$SCRIPTNAME: ldconfig (generate, fallback)"
			/sbin/ldconfig -X
		fi

		# Step 3: Mount remaining overlays in parallel (using cached libs)
		ts "$SCRIPTNAME: mount others (parallel)"
		IFS=":" read -r -a FOLDERS_ARRAY <<< "$OTHER_FOLDERS"

		# Build mkdir list and create all directories at once
		MKDIRS=()
		for entry in "${FOLDERS_ARRAY[@]}"; do
			folder="${entry%%(*}"
			bfolder="${folder##*/}"
			MKDIRS+=("$VOLATILE/${bfolder}_upper" "$VOLATILE/${bfolder}_work")
		done
		mkdir -p "${MKDIRS[@]}"

		# Copy permissions from lowerdir to upperdir in parallel
		for entry in "${FOLDERS_ARRAY[@]}"; do
			folder="${entry%%(*}"
			bfolder="${folder##*/}"
			chown --reference="$folder" "$VOLATILE/${bfolder}_upper" &
			chmod --reference="$folder" "$VOLATILE/${bfolder}_upper" &
		done
		wait

		# Mount overlays in parallel
		for entry in "${FOLDERS_ARRAY[@]}"; do
			folder="${entry%%(*}"
			options="${entry#*(}" options="${options%)}"
			bfolder="${folder##*/}"
			upperdir="$VOLATILE/${bfolder}_upper"
			workdir="$VOLATILE/${bfolder}_work"

			if is_mountpoint "$folder"; then
				continue
			fi

			mount_opts="lowerdir=$folder,upperdir=$upperdir,workdir=$workdir"
			[[ -n "$options" && "$options" != "$folder" ]] && mount_opts="$mount_opts,$options"

			mount -t overlay overlay -o "$mount_opts" "$folder" &
		done
		wait

		ts "$SCRIPTNAME: end"
		;;
	stop)
		IFS=":" read -r -a FOLDERS_ARRAY <<< "$ETC_ENTRY:$OTHER_FOLDERS"
		for entry in "${FOLDERS_ARRAY[@]}"; do
			folder="${entry%%(*}"
			if is_mountpoint "$folder"; then
				umount "$folder" && echo "$folder unmounted."
			fi
		done
		;;
	*)
		echo "Usage: $SCRIPTNAME {start|stop}" >&2
		exit 1
		;;
esac
