# Configure Loopback
auto lo
iface lo inet loopback

# Configure eth0: Train network interface
iface eth0 inet dhcp
    hostname $(hostname)
    udhcpc_opts -V 'Faiveley Transport' -b -S -t 0

# Configure eth1: Maintenance interface
iface eth1 inet static
    address 192.168.0.1
    netmask 255.255.255.0
    gateway 192.168.0.254
